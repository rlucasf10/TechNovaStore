FROM node:20-alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

WORKDIR /workspace

# Copy root workspace files
COPY package*.json ./
COPY tsconfig.json ./
COPY tsconfig.base.json ./
COPY jest.config.base.js ./

# Copy ALL shared packages (source and config)
COPY shared/ ./shared/

# Create services directory structure (needed for file: references)
RUN mkdir -p services

# Install workspace root dependencies (if any)
RUN npm install || true

# Install dependencies and build each shared package in correct order
# 1. Build types first (no dependencies)
WORKDIR /workspace/shared/domain/types
RUN npm install --legacy-peer-deps && npm run build

# 2. Build config (depends on types)
WORKDIR /workspace/shared/infrastructure/config
RUN npm install --legacy-peer-deps && npm run build

# 3. Build utils (depends on types and config)
WORKDIR /workspace/shared/infrastructure/utils
RUN npm install --legacy-peer-deps && npm run build

# 4. Build models (depends on config)
WORKDIR /workspace/shared/domain/models
RUN npm install --legacy-peer-deps && npm run build

# Return to workspace root
WORKDIR /workspace

# Default expose port (can be overridden)
EXPOSE 3000

# Default health check (can be overridden)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1