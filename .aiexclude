# Archivos y carpetas que Gemini Code Assist debe ignorar
# Optimizado para MÁXIMA velocidad de indexación y cero ruido

# --- CRÍTICO: Dependencias y Lock Files ---
# El uso de **/ asegura que se ignoren en cualquier nivel de profundidad
**/node_modules/**
**/node_modules
node_modules/

# Archivos de bloqueo (Suelen ser enormes y ralentizan el parseo)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Frameworks & Build Outputs ---
dist/
build/
out/
.next/
.nuxt/
.output/
.serverless/
target/
vendor/
bin/
obj/

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
*.lcov
*.xml

# --- Caches ---
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
*.pyc
__pycache__/

# --- IDE & System Metadata ---
.git/
.svn/
.hg/
.idea/
.vscode/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Archivos Temporales y Backups ---
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# --- Archivos Binarios y de Medios Grandes ---
# Evita que intente leer binarios como texto
*.zip
*.tar.gz
*.rar
*.7z
*.sql
*.sqlite
*.db
*.dump
*.pdf
*.ico
*.jpg
*.jpeg
*.png
*.gif
*.svg
