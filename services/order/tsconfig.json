{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "removeComments": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@technovastore/shared-types": ["../../shared/types/src"],
      "@technovastore/shared-models": ["../../shared/models/src"]
    },
    "types": ["node", "express"],
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "../../shared/**/*"
  ]
}
