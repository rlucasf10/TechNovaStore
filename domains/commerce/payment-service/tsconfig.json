{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["node", "express", "jest"],
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../../../node_modules/@types"],
    "allowJs": true,
    "checkJs": false,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "../../../shared/**/*"
  ]
}
