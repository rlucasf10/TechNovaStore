{
  "name": "@technovastore/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "build:pages:win": "next build && xcopy /E /I .next\\static .next\\standalone\\.next\\static && xcopy /E /I public .next\\standalone\\public",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:critical": "playwright test e2e/tests/critical-flows.spec.ts",
    "test:e2e:visual": "playwright test e2e/tests/visual-regression.spec.ts",
    "test:e2e:performance": "playwright test e2e/tests/performance.spec.ts",
    "test:e2e:accessibility": "playwright test e2e/tests/accessibility.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:e2e:validate": "node e2e/validate-setup.js",
    "generate-postal-codes": "npx tsx scripts/generate-postal-codes-dataset.ts",
    "validate-postal-codes": "npx tsx scripts/validate-postal-codes-dataset.ts",
    "generate-locations": "npx tsx scripts/generate-spain-locations.ts",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "analyze:report": "npm run build && node scripts/analyze-bundle.js",
    "analyze:deps": "node scripts/check-unused-deps.js",
    "analyze:imports": "node scripts/optimize-imports.js",
    "analyze:all": "npm run analyze:deps && npm run analyze:imports && npm run analyze:report"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "^5.8.0",
    "@tanstack/react-query-devtools": "^5.8.0",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.3",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^2.6.0",
    "jspdf": "3.0.4",
    "lucide-react": "^0.469.0",
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.65.0",
    "react-window": "^2.2.3",
    "recharts": "^2.10.0",
    "socket.io-client": "^4.6.1",
    "tailwind-merge": "^2.0.0",
    "web-vitals": "^4.2.4",
    "zod": "3.25.76",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.0.0",
    "@next/bundle-analyzer": "16.1.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.11.0",
    "baseline-browser-mapping": "2.9.10",
    "cross-env": "10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "5.5.4",
    "exceljs": "^4.4.0",
    "fast-check": "^4.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.31",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
