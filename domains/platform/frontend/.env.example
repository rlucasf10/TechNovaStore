# ============================================================================
# TechNovaStore Frontend - Variables de Entorno (Ejemplo)
# ============================================================================
# 
# IMPORTANTE: Este archivo es un EJEMPLO y debe ser commiteado al repositorio.
# Los valores reales deben estar en .env.local (NO commitear)
#
# Para configurar tu entorno local:
# 1. Copia este archivo: cp .env.example .env.local
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA commitees .env.local al repositorio
#
# ============================================================================

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------

# URL del API Gateway (backend)
# Desarrollo: http://localhost:3000/api
# Producción: https://api.technovastore.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# URL interna del API (para SSR)
# Usado en server-side rendering para comunicación directa con el backend
INTERNAL_API_URL=http://api-gateway:3000/api

# ----------------------------------------------------------------------------
# Chatbot Service
# ----------------------------------------------------------------------------

# URL del servicio de chatbot
NEXT_PUBLIC_CHATBOT_URL=http://localhost:3009

# ----------------------------------------------------------------------------
# Payment Gateways (NUNCA commitear las keys reales)
# ----------------------------------------------------------------------------

# Stripe (Procesamiento de pagos)
# Obtener en: https://dashboard.stripe.com/apikeys
# IMPORTANTE: Solo la publishable key es pública (NEXT_PUBLIC_*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# PayPal (Procesamiento de pagos)
# Obtener en: https://developer.paypal.com/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ----------------------------------------------------------------------------
# OAuth Providers (NUNCA commitear los secrets reales)
# ----------------------------------------------------------------------------

# Google OAuth 2.0
# Obtener en: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# GitHub OAuth
# Obtener en: https://github.com/settings/developers
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# ----------------------------------------------------------------------------
# Analytics & Monitoring (Opcional)
# ----------------------------------------------------------------------------

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here

# ----------------------------------------------------------------------------
# Feature Flags (Opcional)
# ----------------------------------------------------------------------------

# Habilitar modo de desarrollo
# NODE_ENV=development

# Habilitar logs de debug
# NEXT_PUBLIC_DEBUG=false

# Habilitar OAuth
# NEXT_PUBLIC_OAUTH_ENABLED=true

# ----------------------------------------------------------------------------
# External Services (Opcional)
# ----------------------------------------------------------------------------

# Google Maps API (para autocompletado de direcciones)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary (para imágenes)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# ----------------------------------------------------------------------------
# NOTAS DE SEGURIDAD
# ----------------------------------------------------------------------------
#
# 1. Variables con prefijo NEXT_PUBLIC_* son PÚBLICAS y se exponen al cliente
#    - Solo usar para keys públicas (Stripe publishable, Google Client ID, etc.)
#    - NUNCA usar para secrets (API secrets, private keys, etc.)
#
# 2. Variables sin prefijo son PRIVADAS y solo están disponibles en el servidor
#    - Usar para secrets que no deben exponerse al cliente
#    - Ejemplo: STRIPE_SECRET_KEY, DATABASE_URL, etc.
#
# 3. NUNCA commitear archivos .env.local o .env.production
#    - Estos archivos contienen credenciales reales
#    - Deben estar en .gitignore
#
# 4. Para producción, configurar variables de entorno en el servidor/hosting
#    - Vercel: Settings > Environment Variables
#    - Docker: docker-compose.yml o .env.production
#    - AWS: Parameter Store o Secrets Manager
#
# ============================================================================
