{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/shared/*": [
        "./src/shared/*"
      ],
      "@/shared": [
        "./src/shared"
      ],
      "@/features/*": [
        "./src/features/*"
      ],
      "@/catalog/*": [
        "./src/features/catalog/*"
      ],
      "@/catalog": [
        "./src/features/catalog"
      ],
      "@/commerce/*": [
        "./src/features/commerce/*"
      ],
      "@/commerce": [
        "./src/features/commerce"
      ],
      "@/customer/*": [
        "./src/features/customer/*"
      ],
      "@/customer": [
        "./src/features/customer"
      ],
      "@/support/*": [
        "./src/features/support/*"
      ],
      "@/support": [
        "./src/features/support"
      ],
      "@/admin/*": [
        "./src/features/admin/*"
      ],
      "@/admin": [
        "./src/features/admin"
      ],
      "@/components/*": [
        "./src/shared/components/*"
      ],
      "@/ui/*": [
        "./src/shared/components/ui/*"
      ],
      "@/ui": [
        "./src/shared/components/ui"
      ],
      "@/layout/*": [
        "./src/shared/components/layout/*"
      ],
      "@/layout": [
        "./src/shared/components/layout"
      ],
      "@/lib/*": [
        "./src/shared/lib/*"
      ],
      "@/hooks/*": [
        "./src/shared/hooks/*"
      ],
      "@/types/*": [
        "./src/shared/types/*"
      ],
      "@/types": [
        "./src/shared/types"
      ],
      "@/services/*": [
        "./src/shared/services/*"
      ],
      "@/store/*": [
        "./src/shared/store/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "src/types/jest-dom.d.ts",
    "src/types/global.d.ts",
    ".next/dev/types/**/*.ts"
, "src/app/(public)/test-animated-modal/page.tsx", "src/app/global-error.tsx.bk", "src/app/global-error.tsx"  ],
  "exclude": [
    "node_modules",
    "test/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
