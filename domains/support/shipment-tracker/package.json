{
  "name": "@technovastore/shipment-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Automated shipment tracking service for TechNovaStore",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint **/*.ts --ignore-pattern 'dist/**' --ignore-pattern 'node_modules/**'",
    "lint:fix": "eslint **/*.ts --fix --ignore-pattern 'dist/**' --ignore-pattern 'node_modules/**'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@technovastore/shared-config": "file:../../../shared/infrastructure/config",
    "@technovastore/shared-types": "file:../../../shared/domain/types",
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "7.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.0",
    "pg": "^8.11.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-validator": "2.20.33",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.0",
    "@types/pg": "^8.10.9",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "shipment",
    "tracking",
    "ecommerce",
    "automation",
    "logistics"
  ]
}
