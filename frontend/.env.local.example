# ============================================
# CONFIGURACIÓN DEL FRONTEND - INSTRUCCIONES
# TechNovaStore Frontend Environment Variables
# ============================================
#
# ⚠️ IMPORTANTE: Este archivo es solo para REFERENCIA.
# 
# === EN DESARROLLO CON DOCKER (RECOMENDADO) ===
# - Las variables se configuran en .env.docker (raíz del proyecto)
# - Docker Compose las inyecta automáticamente al contenedor
# - NO necesitas crear .env.local manualmente
# - Ver: .env.docker.example en la raíz del proyecto
#
# === EN DESARROLLO LOCAL (SIN DOCKER) ===
# - Copia este archivo a .env.local
# - Configura las variables según tu entorno
# - .env.local está en .gitignore (no se sube al repositorio)
#
# ============================================

# --- API Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3011

# --- App Configuration ---
NEXT_PUBLIC_APP_NAME=TechNovaStore
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Chatbot Configuration ---
NEXT_PUBLIC_CHATBOT_URL=http://localhost:3009
NEXT_PUBLIC_SOCKET_URL=http://localhost:3009

# --- OAuth Configuration (Opcional) ---
# Para habilitar autenticación con Google y GitHub:

# Google OAuth 2.0
# 1. Ir a: https://console.cloud.google.com/
# 2. Crear proyecto o seleccionar existente
# 3. Habilitar Google+ API
# 4. Ir a "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth 2.0"
# 5. Tipo: "Aplicación web"
# 6. URI de redirección autorizada:
#    - Desarrollo: http://localhost:3011/auth/callback/google
#    - Producción: https://tudominio.com/auth/callback/google
# 7. Copiar el Client ID aquí:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth
# 1. Ir a: https://github.com/settings/developers
# 2. Click "OAuth Apps" → "New OAuth App"
# 3. Application name: TechNovaStore
# 4. Homepage URL: http://localhost:3011 (desarrollo)
# 5. Authorization callback URL:
#    - Desarrollo: http://localhost:3011/auth/callback/github
#    - Producción: https://tudominio.com/auth/callback/github
# 6. Copiar el Client ID aquí:
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ⚠️ IMPORTANTE - SEGURIDAD DE CLIENT SECRETS ⚠️
# 
# Los Client Secrets NO deben estar en el frontend:
# - El código del frontend es público (visible en el navegador)
# - Exponer el Client Secret permitiría a atacantes suplantar tu aplicación
# 
# ✅ CORRECTO: Client ID en frontend (público, seguro)
# ❌ INCORRECTO: Client Secret en frontend (privado, inseguro)
# 
# Los Client Secrets se configuran SOLO en el backend:
# - Ver: .env.shared.example (variables GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET)
# - Usados por: user-service para validar tokens de OAuth
#
# El flujo OAuth correcto:
# 1. Frontend redirige a Google/GitHub con Client ID
# 2. Usuario autoriza la aplicación
# 3. Google/GitHub redirige con authorization code
# 4. Frontend envía code al backend
# 5. Backend intercambia code por access token usando Client Secret
# 6. Backend valida y crea sesión

# --- Analytics Configuration (Opcional) ---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true

# ============================================
# REFERENCIAS
# ============================================
# - Configuración de desarrollo: .env.docker.example (raíz)
# - Configuración de producción: .env.prod.example (raíz)
# - Variables compartidas: .env.shared.example (raíz)
# ============================================