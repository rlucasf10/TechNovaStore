# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# App Configuration
NEXT_PUBLIC_APP_NAME=TechNovaStore
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3011

# Chatbot Configuration
NEXT_PUBLIC_CHATBOT_URL=http://localhost:3009
NEXT_PUBLIC_SOCKET_URL=http://localhost:3009

# OAuth Configuration
# Para habilitar autenticación con Google y GitHub, configura los siguientes valores:

# Google OAuth 2.0
# 1. Ir a: https://console.cloud.google.com/
# 2. Crear proyecto o seleccionar existente
# 3. Habilitar Google+ API
# 4. Ir a "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth 2.0"
# 5. Tipo: "Aplicación web"
# 6. URI de redirección: http://localhost:3011/auth/callback/google (desarrollo)
#                        https://tudominio.com/auth/callback/google (producción)
# 7. Copiar el Client ID aquí:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# GitHub OAuth
# 1. Ir a: https://github.com/settings/developers
# 2. Click "OAuth Apps" → "New OAuth App"
# 3. Application name: TechNovaStore
# 4. Homepage URL: http://localhost:3011 (desarrollo)
# 5. Authorization callback URL: http://localhost:3011/auth/callback/github (desarrollo)
#                                https://tudominio.com/auth/callback/github (producción)
# 6. Copiar el Client ID aquí:
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id-here

# ⚠️ IMPORTANTE - SEGURIDAD DE CLIENT SECRETS ⚠️
# 
# Los Client Secrets NO deben estar en el frontend por razones de seguridad:
# - El código del frontend es público (visible en el navegador)
# - Exponer el Client Secret permitiría a atacantes suplantar tu aplicación
# 
# ✅ CORRECTO: Client ID en frontend (público, seguro)
# ❌ INCORRECTO: Client Secret en frontend (privado, inseguro)
# 
# Los Client Secrets deben configurarse SOLO en el backend:
# - API Gateway: backend-services/api-gateway/.env
# - User Service: backend-services/user-service/.env
# 
# Variables de entorno del backend:
# GOOGLE_CLIENT_SECRET=tu-google-client-secret-aqui
# GITHUB_CLIENT_SECRET=tu-github-client-secret-aqui
#
# El backend usa el Client Secret para intercambiar el authorization code
# por el access token de forma segura.

# Analytics Configuration (opcional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id-here
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Feature Flags
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true