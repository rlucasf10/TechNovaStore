{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "removeComments": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@technovastore/shared-types": ["../../shared/types/src"],
      "@technovastore/shared-models": ["../../shared/models/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../../shared/**/__tests__/**",
    "../../shared/**/test/**",
    "../../shared/**/*.test.ts",
    "../../shared/**/*.spec.ts",
    "../../shared/utils/src/test/**"
  ]
}