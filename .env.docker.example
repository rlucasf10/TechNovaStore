# ============================================
# TechNovaStore - Configuración de Desarrollo con Docker
# ============================================
#
# Este archivo contiene variables específicas para el entorno de desarrollo con Docker.
# Debe usarse junto con .env.shared.example para configuración completa.
#
# INSTRUCCIONES DE USO:
# 1. Copiar este archivo: cp .env.docker.example .env.docker
# 2. Copiar archivo compartido: cp .env.shared.example .env.shared
# 3. Editar ambos archivos con tus valores
# 4. Iniciar servicios: docker-compose -f docker-compose.optimized.yml up -d
#
# NOTA: Este archivo está en .gitignore y NO debe subirse al repositorio
#
# ============================================

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Credenciales de Bases de Datos (Docker) ---
# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_this_secure_password_123
MONGO_USERNAME=admin
MONGO_PASSWORD=change_this_secure_password_123

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_secure_password_456
POSTGRES_USERNAME=admin

# Redis
REDIS_PASSWORD=change_this_secure_password_789

# --- Seguridad ---
# JWT Secret (cambiar en producción)
JWT_SECRET=change_this_super_secret_jwt_key_with_at_least_32_characters

# --- URLs Públicas del Frontend ---
# Estas variables son accesibles desde el navegador (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3011
NEXT_PUBLIC_CHATBOT_URL=http://localhost:3009
NEXT_PUBLIC_SOCKET_URL=http://localhost:3009

# URL del frontend (para CORS y redirects)
FRONTEND_URL=http://localhost:3011

# --- URLs de Aplicación ---
API_BASE_URL=http://localhost:3000

# --- OAuth Configuration (Development) ---
# Dejar vacío si no se configura OAuth en desarrollo
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- Analytics Configuration (Development) ---
# Deshabilitado en desarrollo
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# --- Monitoreo ---
# Grafana Admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# --- SMTP Configuration (for notifications) ---
# Configuración de email para desarrollo
SMTP_USER=your-email@gmail.com
SMTP_PASS=change_this_smtp_password

# --- APIs Externas (Development - Opcional) ---
# Dejar vacío si no se necesitan en desarrollo
AMAZON_API_KEY=
AMAZON_SECRET_KEY=
ALIEXPRESS_API_KEY=
EBAY_API_KEY=
BANGGOOD_API_KEY=
NEWEGG_API_KEY=

# ============================================
# VARIABLES ADICIONALES
# ============================================
# Para variables compartidas entre servicios, ver .env.shared.example
# Para configuración de seguridad avanzada, ver api-gateway/.env.security.example
# Para configuración de logging, ver .env.logging.example
# ============================================
